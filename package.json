{
  "name": "dirus",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "lint": "eslint .",
    "lint:deps": "depcruise --config .dependency-cruiser.cjs --output-type err apps packages",
    "db:generate": "pnpm --filter @dirus/db run db:generate",
    "db:migrate": "pnpm --filter @dirus/db run db:migrate",
    "db:check": "pnpm --filter @dirus/db run db:check"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@types/node": "^22.10.5",
    "dependency-cruiser": "^16.9.0",
    "eslint": "^9.18.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.19.1",
    "vitest": "^2.1.8"
  }
}
