# Postgres (Neon) — two-URL model (see design.md D-B, packages/db/README.md)
#
# DATABASE_URL: pooled endpoint (PgBouncer transaction mode, hostname contains
# "-pooler"). Used by the app runtime client only. Never used for DDL.
DATABASE_URL=

# DATABASE_URL_UNPOOLED: direct endpoint (no "-pooler" in the hostname). Used
# by db:generate / db:migrate / db:check and drizzle.config.ts. DDL statements
# (CREATE EXTENSION, CREATE ROLE, ALTER TABLE ... FORCE ROW LEVEL SECURITY)
# must not cross a transaction pooler.
DATABASE_URL_UNPOOLED=

# Set to 1 to allow the app runtime client to start against a non-pooled host.
# Documented interim only — do not enable in production.
ALLOW_UNPOOLED_RUNTIME=

# apps/api (see apps/api/src/env.ts, design.md D-5 in the
# whatsapp-webhook-ingress change). apps/api validates only these — it
# deliberately does not re-validate DATABASE_URL above.

# Bearer credential compared with crypto.timingSafeEqual (design D-4).
# Chatwoot's webhook authenticity check, not a signature — a compensating
# control. >= 32 bytes of entropy.
CHATWOOT_WEBHOOK_TOKEN=

# Chatwoot instance base URL used by packages/integrations/src/chatwoot.ts.
CHATWOOT_BASE_URL=

# Chatwoot API access token used to send the echo reply.
CHATWOOT_API_ACCESS_TOKEN=

# Chatwoot account id the webhook events belong to.
CHATWOOT_ACCOUNT_ID=

# Port apps/api listens on.
PORT=

# A1 (policy-bulk-import) phase 3, proposal P2: provisional shared-bearer
# token for POST /admin/policies/import, compared with
# crypto.timingSafeEqual (see apps/api/src/middleware/admin-auth.ts). A
# compensating control, not a login system — superseded once
# admin-dashboard (C1) ships real broker/admin authentication. >= 32 bytes
# of entropy, same shape as CHATWOOT_WEBHOOK_TOKEN above. Sent in the
# X-Dirus-Admin-Token header.
ADMIN_API_TOKEN=
